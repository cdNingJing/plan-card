{
  "app_config": {
    "version": "1.0.0",
    "build_number": "20240101",
    "last_update": "2024-01-01T00:00:00.000Z",
    "update_channel": "stable",
    "environment": "production",
    "debug_mode": false
  },
  "features": {
    "chat_enabled": true,
    "file_upload": true,
    "offline_mode": false,
    "sync_enabled": true,
    "ai_assistant": true,
    "voice_input": false,
    "gesture_control": true,
    "dark_mode": true
  },
  "system": {
    "max_file_size": 10485760,
    "supported_formats": ["json", "txt", "md", "csv", "xml"],
    "cache_size": 52428800,
    "session_timeout": 3600000,
    "max_concurrent_requests": 5,
    "request_timeout": 30000
  },
  "api": {
    "base_url": "https://api.example.com",
    "version": "v1",
    "timeout": 30000,
    "retry_attempts": 3,
    "rate_limit": {
      "requests_per_minute": 60,
      "burst_limit": 10
    }
  },
  "security": {
    "encryption_enabled": true,
    "ssl_required": true,
    "session_secure": true,
    "csrf_protection": true,
    "xss_protection": true,
    "content_security_policy": "default-src 'self'"
  },
  "performance": {
    "lazy_loading": true,
    "image_optimization": true,
    "code_splitting": true,
    "service_worker": true,
    "prefetch_enabled": true,
    "compression_enabled": true
  },
  "monitoring": {
    "error_tracking": true,
    "performance_monitoring": true,
    "user_analytics": true,
    "crash_reporting": true,
    "log_level": "info"
  }
} 